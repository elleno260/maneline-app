{
  "expo": {
    "name": "ManeLine-App",
    "slug": "maneline-app",
    "version": "1.0.0",
    "scheme": "maneline",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",

    "plugins": [
      "expo-router",

      "@react-native-firebase/app",
      "@react-native-firebase/app-check",

      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static"
          }
        }
      ],

      "expo-font"
    ],

    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",

      "infoPlist": {
        "NSCameraUsageDescription": "ManeLine needs camera access to scan products and ingredient labels.",
        "NSPhotoLibraryUsageDescription": "ManeLine needs photo access so you can upload product label images."
      },

      "bundleIdentifier": "com.elleno260.manelineapp"
    },

    "android": {
      "googleServicesFile": "./google-services.json",

      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "READ_MEDIA_IMAGES"
      ],

      "package": "com.elleno260.manelineapp"
    }
  }
}